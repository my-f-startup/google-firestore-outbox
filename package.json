{
  "name": "@my-f-startup/google-firestore-outbox",
  "version": "0.1.0",
  "description": "Transactional outbox for Google Firestore: stores messages in the transaction that changes the data and publishes them afterwards.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:ts": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/**/*.spec.ts",
    "test:unit": "tsx --test --test-concurrency=1 test/*.unit.spec.ts",
    "test:int": "tsx --test --test-concurrency=1 test/*.int.spec.ts",
    "test:e2e": "tsx --test --test-concurrency=1 test/*.e2e.spec.ts"
  },
  "keywords": [
    "firestore",
    "google-cloud",
    "outbox",
    "transactional-outbox",
    "messaging",
    "event-driven"
  ],
  "author": "My Fucking Startup",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/my-f-startup/google-firestore-outbox.git"
  },
  "bugs": {
    "url": "https://github.com/my-f-startup/google-firestore-outbox/issues"
  },
  "homepage": "https://github.com/my-f-startup/google-firestore-outbox#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@google-cloud/firestore": "^7.10.0"
  },
  "devDependencies": {
    "@emmett-community/emmett-google-firestore": "^0.7.0",
    "@google-cloud/firestore": "^7.10.0",
    "@types/node": "^25.0.3",
    "testcontainers": "^10.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
